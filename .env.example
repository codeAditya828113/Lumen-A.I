# =====================================================================
# Lumen AI - Environment Configuration Example
# Copy this file to '.env' or '.env.local' and populate with your credentials.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Gemini AI API Configuration (Server-Side)
# ---------------------------------------------------------------------
# Obtain your free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ---------------------------------------------------------------------
# 2. Firebase Server Configuration (Firebase Admin SDK)
# ---------------------------------------------------------------------
# Used by the server for cryptographic ID token verification & Firestore rate limiting
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_DATABASE_ID="(default)"

# ---------------------------------------------------------------------
# 3. Firebase Client Configuration (Vite Web App)
# ---------------------------------------------------------------------
# Obtain these from Firebase Console -> Project Settings -> General -> Your Apps (Web App)
VITE_FIREBASE_API_KEY="your_client_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_firebase_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_FIREBASE_DATABASE_ID="(default)"

# ---------------------------------------------------------------------
# 4. Server & Hosting Runtime Configuration
# ---------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Rate Limit Storage: 'memory' for local dev/testing, 'firestore' for multi-replica production
RATE_LIMIT_STORE="memory"
